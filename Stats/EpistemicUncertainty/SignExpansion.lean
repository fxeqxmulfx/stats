module

/-
  Actual sign-vector generation of varying-error populations,
  arXiv:1912.00277v2, Section II, Eq. gn and matrix M. The existing
  recursive probability laws are identified with all 2^n fair branches.
-/
public import Stats.EpistemicUncertainty.SignLaw

@[expose] public section

open Real Set MeasureTheory ProbabilityTheory Finset

namespace TailOptionPricing

/-- Section II's actual uniform sign law is the finite Dirac sum
with the proved branch probability 2^(-n). -/
theorem epistemicSignLaw_eq_sum (n : ℕ) :
    epistemicSignLaw n = ∑ b : Fin n → Bool, (1 / 2 : ENNReal) ^ n • Measure.dirac b := by
  simp [epistemicSignLaw, Measure.uniformOfFinset, ENNReal.inv_pow, div_eq_mul_inv]

/-- The genuine varying-error dispersion law is the printed sum over
all sign-vector scales (Section II). The proof expands the actual
recursive branches and reindexes by the last sign. -/
theorem epistemicLayerScaleLaw_eq_sign_sum (n : ℕ) (σ : ℝ) (ε : ℕ → ℝ) :
    epistemicLayerScaleLaw n σ ε = ∑ b : Fin n → Bool,
      (1 / 2 : ENNReal) ^ n • Measure.dirac (epistemicSignScale n σ ε b) := by
  induction n generalizing σ with
  | zero => simp [epistemicLayerScaleLaw, epistemicSignScale]
  | succ n ih =>
    rw [epistemicLayerScaleLaw, ih, ih, equalMixture, epistemicSign_sum_snoc]
    simp only [epistemicSignScale_snoc, Bool.false_eq_true, ite_true, ite_false,
      pow_succ' (1 / 2 : ENNReal) n, Finset.smul_sum, smul_smul]

/-- The actual recursive dispersion is generated by the explicit
independent uniform sign vector and the source's multiplicative scale
function (Section II). This identifies the whole probability measure. -/
theorem epistemicLayerScaleLaw_eq_sign_map (n : ℕ) (σ : ℝ) (ε : ℕ → ℝ) :
    epistemicLayerScaleLaw n σ ε =
      (epistemicSignLaw n).map (epistemicSignScale n σ ε) := by
  have hm : Measurable (epistemicSignScale n σ ε) := measurable_of_countable _
  rw [epistemicLayerScaleLaw_eq_sign_sum, epistemicSignLaw_eq_sum,
    Measure.map_finset_sum hm.aemeasurable]
  simp_rw [Measure.map_smul _ hm.aemeasurable, Measure.map_dirac]

/-- The genuine varying-error outcome law is exactly Section II's
2^n-component fair Gaussian mixture (Eq. gn). Each actual variance is
the square of the printed sign-vector standard deviation. -/
theorem epistemicLayerBranchLaw_eq_sign_mixture (n : ℕ) (μ σ : ℝ) (ε : ℕ → ℝ) :
    epistemicLayerBranchLaw n μ σ ε = ∑ b : Fin n → Bool,
      (1 / 2 : ENNReal) ^ n • gaussianReal μ
        (NNReal.mk ((epistemicSignScale n σ ε b) ^ 2) (sq_nonneg _)) := by
  induction n generalizing σ with
  | zero => simp [epistemicLayerBranchLaw, epistemicSignScale]
  | succ n ih =>
    rw [epistemicLayerBranchLaw, ih, ih, equalMixture, epistemicSign_sum_snoc]
    simp only [epistemicSignScale_snoc, Bool.false_eq_true, ite_true, ite_false,
      pow_succ' (1 / 2 : ENNReal) n, Finset.smul_sum, smul_smul]

/-- Sample the actual independent fair signs and an independent
standard Gaussian, then use the printed varying-error scale. This
generates exactly the actual outcome population (Section II, Eq. gn). -/
theorem epistemicSignLaw_outcome_model (n : ℕ) (μ σ : ℝ) (ε : ℕ → ℝ) :
    ((epistemicSignLaw n).prod (gaussianReal 0 1)).map
      (fun p : (Fin n → Bool) × ℝ => μ + epistemicSignScale n σ ε p.1 * p.2) =
        epistemicLayerBranchLaw n μ σ ε := by
  have hs : Measurable (epistemicSignScale n σ ε) := measurable_of_countable _
  have hm : Measurable (fun p : ℝ × ℝ => μ + p.1 * p.2) :=
    (measurable_fst.mul measurable_snd).const_add μ
  have hp : ((epistemicSignLaw n).map (epistemicSignScale n σ ε)).prod (gaussianReal 0 1) =
      ((epistemicSignLaw n).prod (gaussianReal 0 1)).map
        (Prod.map (epistemicSignScale n σ ε) (id : ℝ → ℝ)) := by
    simpa only [Measure.map_id] using
      Measure.map_prod_map (epistemicSignLaw n) (gaussianReal 0 1) hs measurable_id
  have h := epistemicLayerScaleLaw_outcome_model n μ σ ε
  rw [epistemicLayerScaleLaw_eq_sign_map, hp, Measure.map_map hm (hs.prodMap measurable_id)] at h
  exact h

example : epistemicLayerScaleLaw 2 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i) =
    (epistemicSignLaw 2).map (epistemicSignScale 2 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i)) :=
  epistemicLayerScaleLaw_eq_sign_map _ _ _

example : epistemicLayerBranchLaw 2 1 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i) =
    ∑ b : Fin 2 → Bool, (1 / 2 : ENNReal) ^ 2 • gaussianReal 1
      (NNReal.mk ((epistemicSignScale 2 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i) b) ^ 2)
        (sq_nonneg _)) := epistemicLayerBranchLaw_eq_sign_mixture _ _ _ _

example : ((epistemicSignLaw 2).prod (gaussianReal 0 1)).map
    (fun p : (Fin 2 → Bool) × ℝ =>
      1 + epistemicSignScale 2 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i) p.1 * p.2) =
        epistemicLayerBranchLaw 2 1 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i) :=
  epistemicSignLaw_outcome_model _ _ _ _

#print axioms epistemicLayerScaleLaw_eq_sign_map
#print axioms epistemicLayerBranchLaw_eq_sign_mixture
#print axioms epistemicSignLaw_outcome_model

end TailOptionPricing
