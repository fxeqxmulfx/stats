module

/-
  Actual nested mixtures from conditional density inputs,
  arXiv:1912.00277v2, Section II after Eq. 1. The source's Gaussian
  uses the sampled observation scale, not its printed fixed sigma.
  Conditional density factors are applied at every positive-scale integral.
  Joint measurability of the conditional density inputs is made explicit.
-/
public import Stats.EpistemicUncertainty.DensityKernel

@[expose] public section

open Real Set MeasureTheory ProbabilityTheory

namespace TailOptionPricing

/-- The source's literal repeated positive-half-line density integrals.
Each stage multiplies its conditional density by the remaining integrand.
The actual probability-law identity is proved separately below. -/
noncomputable def epistemicDensityHierarchyIntegral : ℕ → Measure ℝ →
    (ℕ → ℝ → ℝ → ENNReal) → (ℝ → ENNReal) → ENNReal
  | 0, ν, _, g => ∫⁻ s : ℝ, g s ∂ν
  | n + 1, ν, f, g => epistemicDensityHierarchyIntegral n ν f
      (fun s => ∫⁻ t in Ioi (0 : ℝ), f n s t * g t)

/-- Genuine kernel integration becomes the source's repeated products
of conditional density factors (Section II). Measurability of each inner
kernel integral is proved before the finite induction continues. -/
theorem epistemicHierarchyIntegral_density_inputs (n : ℕ) (ν : Measure ℝ)
    (f : ℕ → ℝ → ℝ → ENNReal) (hf : ∀ i, Measurable (Function.uncurry (f i)))
    (g : ℝ → ENNReal) (hg : Measurable g) :
    epistemicHierarchyIntegral n ν (fun i => epistemicDensityScaleKernel (f i)) g =
      epistemicDensityHierarchyIntegral n ν f g := by
  induction n generalizing g with
  | zero => rfl
  | succ n ih =>
    have hm : Measurable (fun s : ℝ => ∫⁻ t : ℝ, g t ∂epistemicDensityScaleKernel (f n) s) :=
      (Measure.measurable_lintegral hg).comp (epistemicDensityScaleKernel (f n)).measurable
    have he : (fun s : ℝ => ∫⁻ t : ℝ, g t ∂epistemicDensityScaleKernel (f n) s) =
        (fun s : ℝ => ∫⁻ t in Ioi (0 : ℝ), f n s t * g t) :=
      funext (fun s => epistemicDensityScaleKernel_lintegral (f n) (hf n) s g hg)
    change epistemicHierarchyIntegral n ν (fun i => epistemicDensityScaleKernel (f i))
      (fun s : ℝ => ∫⁻ t : ℝ, g t ∂epistemicDensityScaleKernel (f n) s) = _
    rw [ih _ hm, he]
    rfl

/-- Actual Gaussian population generated by the source's conditional
density inputs, through genuine measurable kernels and probability laws. -/
noncomputable def epistemicDensityHierarchyLaw (n : ℕ) (μ : ℝ) (ν : Measure ℝ)
    (f : ℕ → ℝ → ℝ → ENNReal) : Measure ℝ :=
  epistemicHierarchyOutcomeLaw n μ ν (fun i => epistemicDensityScaleKernel (f i))

/-- Input joint measurability and conditional normalization construct
an actual probability population at every finite depth (Section II). -/
theorem epistemicDensityHierarchyLaw_probability (n : ℕ) (μ : ℝ) (ν : Measure ℝ)
    [IsProbabilityMeasure ν] (f : ℕ → ℝ → ℝ → ENNReal)
    (hf : ∀ i, Measurable (Function.uncurry (f i)))
    (hn : ∀ i s, (∫⁻ t in Ioi (0 : ℝ), f i s t) = 1) :
    IsProbabilityMeasure (epistemicDensityHierarchyLaw n μ ν f) := by
  let inst (i : ℕ) : IsMarkovKernel (epistemicDensityScaleKernel (f i)) :=
    epistemicDensityScaleKernel_markov (f i) (hf i) (hn i)
  unfold epistemicDensityHierarchyLaw
  infer_instance

/-- Section II's corrected nested Gaussian density, with every source
conditional Lebesgue-density factor present. The Gaussian uses the
last sampled observation dispersion in the prior-to-outcome ordering. -/
noncomputable def epistemicDensityHierarchyPDF (n : ℕ) (μ : ℝ) (ν : Measure ℝ)
    (f : ℕ → ℝ → ℝ → ENNReal) (x : ℝ) : ENNReal :=
  epistemicDensityHierarchyIntegral n ν f
    (fun s => gaussianPDF μ (NNReal.mk (s ^ 2) (sq_nonneg s)) x)

/-- The actual iterated kernel Gaussian density equals the literal
source density-input integral, by the genuine conditional integration theorem. -/
theorem epistemicHierarchyDensity_eq_density_inputs (n : ℕ) (μ : ℝ) (ν : Measure ℝ)
    (f : ℕ → ℝ → ℝ → ENNReal) (hf : ∀ i, Measurable (Function.uncurry (f i))) (x : ℝ) :
    epistemicHierarchyDensity n μ ν (fun i => epistemicDensityScaleKernel (f i)) x =
      epistemicDensityHierarchyPDF n μ ν f x := by
  unfold epistemicHierarchyDensity epistemicDensityHierarchyPDF
  apply epistemicHierarchyIntegral_density_inputs n ν f hf
  unfold gaussianPDF gaussianPDFReal
  simp only [NNReal.coe_mk]
  fun_prop

/-- With two conditional layers, the actual target density is literally
the double positive-scale integral of f_0*f_1*GaussianPDF (Section II).
Pulling the first factor inside is justified even for nonnegative
extended-valued densities, by measurability of the inner integrand. -/
theorem epistemicDensityHierarchyPDF_two (μ : ℝ) (ν : Measure ℝ)
    (f : ℕ → ℝ → ℝ → ENNReal) (hf : ∀ i, Measurable (Function.uncurry (f i))) (x : ℝ) :
    epistemicDensityHierarchyPDF 2 μ ν f x = ∫⁻ s₀ : ℝ,
      (∫⁻ s₁ in Ioi (0 : ℝ), ∫⁻ s₂ in Ioi (0 : ℝ), f 0 s₀ s₁ * f 1 s₁ s₂ *
        gaussianPDF μ (NNReal.mk (s₂ ^ 2) (sq_nonneg s₂)) x) ∂ν := by
  have hg : Measurable (fun s : ℝ => gaussianPDF μ (NNReal.mk (s ^ 2) (sq_nonneg s)) x) := by
    unfold gaussianPDF gaussianPDFReal
    simp only [NNReal.coe_mk]
    fun_prop
  unfold epistemicDensityHierarchyPDF epistemicDensityHierarchyIntegral
  apply lintegral_congr
  intro s₀
  apply lintegral_congr
  intro s₁
  dsimp only
  have hi : Measurable (fun s₂ : ℝ => f 1 s₁ s₂ *
      gaussianPDF μ (NNReal.mk (s₂ ^ 2) (sq_nonneg s₂)) x) :=
    (hf 1).of_uncurry_left.mul hg
  rw [← lintegral_const_mul (f 0 s₀ s₁) hi]
  simp only [mul_assoc]

/-- The actual marginal law has Section II's corrected literal
repeated density-product integral. Every input kernel's normalization
and positive support are derived from the source density assumptions. -/
theorem epistemicDensityHierarchyLaw_eq_withDensity (n : ℕ) (μ : ℝ) (ν : Measure ℝ)
    [IsProbabilityMeasure ν] (f : ℕ → ℝ → ℝ → ENNReal)
    (hf : ∀ i, Measurable (Function.uncurry (f i)))
    (hn : ∀ i s, (∫⁻ t in Ioi (0 : ℝ), f i s t) = 1)
    (hν : ∀ᵐ s ∂ν, 0 < s) :
    epistemicDensityHierarchyLaw n μ ν f = volume.withDensity (epistemicDensityHierarchyPDF n μ ν f) := by
  let inst (i : ℕ) : IsMarkovKernel (epistemicDensityScaleKernel (f i)) :=
    epistemicDensityScaleKernel_markov (f i) (hf i) (hn i)
  have h := epistemicHierarchyOutcomeLaw_eq_withDensity n μ ν
    (fun i => epistemicDensityScaleKernel (f i)) hν
      (fun i _ s _ => epistemicDensityScaleKernel_ae_pos (f i) (hf i) s)
  have he : epistemicHierarchyDensity n μ ν (fun i => epistemicDensityScaleKernel (f i)) =
      epistemicDensityHierarchyPDF n μ ν f :=
    funext (epistemicHierarchyDensity_eq_density_inputs n μ ν f hf)
  rw [he] at h
  exact h

/-- Measurability of the actual repeated density-input expression,
transported from the genuine measurable Markov hierarchy (Section II). -/
theorem epistemicDensityHierarchyPDF_measurable (n : ℕ) (μ : ℝ) (ν : Measure ℝ)
    [IsProbabilityMeasure ν] (f : ℕ → ℝ → ℝ → ENNReal)
    (hf : ∀ i, Measurable (Function.uncurry (f i)))
    (hn : ∀ i s, (∫⁻ t in Ioi (0 : ℝ), f i s t) = 1) :
    Measurable (epistemicDensityHierarchyPDF n μ ν f) := by
  let inst (i : ℕ) : IsMarkovKernel (epistemicDensityScaleKernel (f i)) :=
    epistemicDensityScaleKernel_markov (f i) (hf i) (hn i)
  have he : epistemicHierarchyDensity n μ ν (fun i => epistemicDensityScaleKernel (f i)) =
      epistemicDensityHierarchyPDF n μ ν f :=
    funext (epistemicHierarchyDensity_eq_density_inputs n μ ν f hf)
  rw [← he]
  exact epistemicHierarchyDensity_measurable _ _ _ _

/-- The source's full repeated conditional density-product integral
has total mass one, from the actual normalized hierarchy law. -/
theorem epistemicDensityHierarchyPDF_lintegral (n : ℕ) (μ : ℝ) (ν : Measure ℝ)
    [IsProbabilityMeasure ν] (f : ℕ → ℝ → ℝ → ENNReal)
    (hf : ∀ i, Measurable (Function.uncurry (f i)))
    (hn : ∀ i s, (∫⁻ t in Ioi (0 : ℝ), f i s t) = 1)
    (hν : ∀ᵐ s ∂ν, 0 < s) :
    (∫⁻ x : ℝ, epistemicDensityHierarchyPDF n μ ν f x) = 1 := by
  let := epistemicDensityHierarchyLaw_probability n μ ν f hf hn
  have h := congrArg (fun ρ : Measure ℝ => ρ univ)
    (epistemicDensityHierarchyLaw_eq_withDensity n μ ν f hf hn hν)
  simpa only [measure_univ, withDensity_apply _ MeasurableSet.univ,
    Measure.restrict_univ] using h.symm

example : IsProbabilityMeasure (epistemicDensityHierarchyLaw 2 1 (Measure.dirac (2 : ℝ))
    (fun _ => epistemicUnitIntervalScalePDF)) :=
  epistemicDensityHierarchyLaw_probability _ _ _ _
    (fun _ => epistemicUnitIntervalScalePDF_measurable)
    (fun _ => epistemicUnitIntervalScalePDF_lintegral)

example (n : ℕ) : (∫⁻ x : ℝ, epistemicDensityHierarchyPDF n 1 (Measure.dirac (2 : ℝ))
    (fun _ => epistemicUnitIntervalScalePDF) x) = 1 := by
  apply epistemicDensityHierarchyPDF_lintegral _ _ _ _
    (fun _ => epistemicUnitIntervalScalePDF_measurable)
    (fun _ => epistemicUnitIntervalScalePDF_lintegral)
  simpa only [ae_dirac_iff measurableSet_Ioi] using (show (0 : ℝ) < 2 by norm_num)

example : epistemicDensityHierarchyLaw 2 1 (Measure.dirac (2 : ℝ))
    (fun _ => epistemicUnitIntervalScalePDF) = volume.withDensity (fun x =>
      ∫⁻ s₀ : ℝ, (∫⁻ s₁ in Ioi (0 : ℝ), epistemicUnitIntervalScalePDF s₀ s₁ *
        (∫⁻ s₂ in Ioi (0 : ℝ), epistemicUnitIntervalScalePDF s₁ s₂ *
          gaussianPDF 1 (NNReal.mk (s₂ ^ 2) (sq_nonneg s₂)) x)) ∂Measure.dirac (2 : ℝ)) := by
  change epistemicDensityHierarchyLaw 2 1 (Measure.dirac (2 : ℝ))
    (fun _ => epistemicUnitIntervalScalePDF) = volume.withDensity
      (epistemicDensityHierarchyPDF 2 1 (Measure.dirac (2 : ℝ)) (fun _ => epistemicUnitIntervalScalePDF))
  apply epistemicDensityHierarchyLaw_eq_withDensity _ _ _ _
    (fun _ => epistemicUnitIntervalScalePDF_measurable)
    (fun _ => epistemicUnitIntervalScalePDF_lintegral)
  simpa only [ae_dirac_iff measurableSet_Ioi] using (show (0 : ℝ) < 2 by norm_num)

