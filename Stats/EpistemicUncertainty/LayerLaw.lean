module

/-
  Actual varying-layer populations, arXiv:1912.00277v2, Sections II and IV.
  Index i=0 represents the source's first error epsilon_1. Each finite
  layer fairly perturbs the dispersion by 1+epsilon_i or 1-epsilon_i.
  The newest layer is expanded first; scalar multiplication commutes.
-/
public import Stats.EpistemicUncertainty.ScaleLaw

@[expose] public section

open Real Set MeasureTheory ProbabilityTheory

namespace TailOptionPricing

/-- Actual dispersion distribution with varying errors (Section II's
finite branching model). Error index i corresponds to source i+1. -/
noncomputable def epistemicLayerScaleLaw : ℕ → ℝ → (ℕ → ℝ) → Measure ℝ
  | 0, σ, _ => Measure.dirac σ
  | n + 1, σ, ε => equalMixture (epistemicLayerScaleLaw n (σ * (1 + ε n)) ε)
      (epistemicLayerScaleLaw n (σ * (1 - ε n)) ε)

/-- Actual varying-error Gaussian population, Sections II and IV,
constructed by genuine finite probability mixtures before its moments. -/
noncomputable def epistemicLayerBranchLaw : ℕ → ℝ → ℝ → (ℕ → ℝ) → Measure ℝ
  | 0, μ, σ, _ => gaussianReal μ (NNReal.mk (σ ^ 2) (sq_nonneg σ))
  | n + 1, μ, σ, ε => equalMixture (epistemicLayerBranchLaw n μ (σ * (1 + ε n)) ε)
      (epistemicLayerBranchLaw n μ (σ * (1 - ε n)) ε)

instance epistemicLayerScaleLaw_probability (n : ℕ) (σ : ℝ) (ε : ℕ → ℝ) :
    IsProbabilityMeasure (epistemicLayerScaleLaw n σ ε) := by
  induction n generalizing σ with
  | zero => unfold epistemicLayerScaleLaw; infer_instance
  | succ n ih =>
    let := ih (σ * (1 + ε n))
    let := ih (σ * (1 - ε n))
    unfold epistemicLayerScaleLaw
    infer_instance

instance epistemicLayerBranchLaw_probability (n : ℕ) (μ σ : ℝ) (ε : ℕ → ℝ) :
    IsProbabilityMeasure (epistemicLayerBranchLaw n μ σ ε) := by
  induction n generalizing σ with
  | zero => unfold epistemicLayerBranchLaw; infer_instance
  | succ n ih =>
    let := ih (σ * (1 + ε n))
    let := ih (σ * (1 - ε n))
    unfold epistemicLayerBranchLaw
    infer_instance

/-- Every real-valued dispersion test is L1 under the genuine finite
atomic population, independently of any moment formula (Section II). -/
theorem epistemicLayerScaleLaw_integrable (n : ℕ) (σ : ℝ) (ε : ℕ → ℝ) (f : ℝ → ℝ) :
    Integrable f (epistemicLayerScaleLaw n σ ε) := by
  induction n generalizing σ with
  | zero => exact integrable_dirac (by finiteness)
  | succ n ih =>
    rw [epistemicLayerScaleLaw, equalMixture_integrable_iff]
    exact ⟨ih _, ih _⟩

/-- All powers about every finite center are L1 under the actual
varying-layer Gaussian population, before evaluation (Sections II–IV). -/
theorem epistemicLayerBranchLaw_integrable_sub_pow (n : ℕ) (μ σ : ℝ) (ε : ℕ → ℝ)
    (c : ℝ) (k : ℕ) :
    Integrable (fun x : ℝ => (x - c) ^ k) (epistemicLayerBranchLaw n μ σ ε) := by
  induction n generalizing σ with
  | zero => exact gaussianReal_integrable_sub_pow _ _ _ _
  | succ n ih =>
    rw [epistemicLayerBranchLaw, equalMixture_integrable_iff]
    exact ⟨ih _, ih _⟩

/-- Actual mean preservation with different finite errors, as required
by the common-mean Gaussian construction of Sections II and IV. -/
theorem epistemicLayerBranchLaw_mean (n : ℕ) (μ σ : ℝ) (ε : ℕ → ℝ) :
    (∫ x : ℝ, x ∂epistemicLayerBranchLaw n μ σ ε) = μ := by
  have hi (m : ℕ) (s : ℝ) : Integrable (fun x : ℝ => x)
      (epistemicLayerBranchLaw m μ s ε) := by
    simpa only [sub_zero, pow_one] using epistemicLayerBranchLaw_integrable_sub_pow m μ s ε 0 1
  induction n generalizing σ with
  | zero => exact integral_id_gaussianReal
  | succ n ih =>
    rw [epistemicLayerBranchLaw, equalMixture_integral (hi _ _) (hi _ _), ih, ih]
    ring

/-- The whole varying-layer outcome law is generated by its actual
dispersion and an independent standard Gaussian (Sections II and IV). -/
theorem epistemicLayerScaleLaw_outcome_model (n : ℕ) (μ σ : ℝ) (ε : ℕ → ℝ) :
    ((epistemicLayerScaleLaw n σ ε).prod (gaussianReal 0 1)).map
      (fun p : ℝ × ℝ => μ + p.1 * p.2) = epistemicLayerBranchLaw n μ σ ε := by
  have hm : Measurable (fun p : ℝ × ℝ => μ + p.1 * p.2) :=
    (measurable_fst.mul measurable_snd).const_add μ
  induction n generalizing σ with
  | zero =>
    rw [epistemicLayerScaleLaw, Measure.dirac_prod, Measure.map_map hm measurable_prodMk_left]
    exact gaussianReal_map_affine_scale μ σ
  | succ n ih =>
    rw [epistemicLayerScaleLaw, equalMixture_prod, equalMixture_map _ _ hm, ih, ih,
      epistemicLayerBranchLaw]

/-- Constant errors recover the already proved actual dispersion law
of Section III, at the level of whole probability measures. -/
theorem epistemicLayerScaleLaw_const (n : ℕ) (σ ε : ℝ) :
    epistemicLayerScaleLaw n σ (fun _ => ε) = epistemicScaleLaw n σ ε := by
  induction n generalizing σ with
  | zero => rfl
  | succ n ih => simp only [epistemicLayerScaleLaw, epistemicScaleLaw, ih]

/-- Constant errors recover Section III's actual Gaussian population. -/
theorem epistemicLayerBranchLaw_const (n : ℕ) (μ σ ε : ℝ) :
    epistemicLayerBranchLaw n μ σ (fun _ => ε) = epistemicBranchLaw n μ σ ε := by
  induction n generalizing σ with
  | zero => rfl
  | succ n ih => simp only [epistemicLayerBranchLaw, epistemicBranchLaw, ih]

/-- The actual varying-layer dispersion is positive a.e. on the
source domain of positive base scale and errors in [0,1) (Section II). -/
theorem epistemicLayerScaleLaw_ae_pos (n : ℕ) {σ : ℝ} {ε : ℕ → ℝ} (hσ : 0 < σ)
    (hε : ∀ i < n, 0 ≤ ε i ∧ ε i < 1) :
    ∀ᵐ s ∂epistemicLayerScaleLaw n σ ε, 0 < s := by
  induction n generalizing σ with
  | zero => simpa only [epistemicLayerScaleLaw, ae_dirac_iff measurableSet_Ioi] using hσ
  | succ n ih =>
    have hn := hε n (Nat.lt_succ_self n)
    have hp : ∀ i < n, 0 ≤ ε i ∧ ε i < 1 := fun i hi => hε i (by omega)
    rw [epistemicLayerScaleLaw, equalMixture, ae_add_measure_iff]
    constructor
    · exact Measure.ae_smul_measure (ih (mul_pos hσ (by linarith)) hp) _
    · exact Measure.ae_smul_measure (ih (mul_pos hσ (by linarith)) hp) _

example : IsProbabilityMeasure
    (epistemicLayerBranchLaw 2 1 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i)) := inferInstance

example : (∫ x : ℝ, x ∂epistemicLayerBranchLaw 2 1 2
    (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i)) = 1 := epistemicLayerBranchLaw_mean _ _ _ _

example : ∀ᵐ s ∂epistemicLayerScaleLaw 2 2
    (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i), 0 < s := by
  apply epistemicLayerScaleLaw_ae_pos _ (by norm_num)
  intro i hi
  interval_cases i <;> norm_num

example : ((epistemicLayerScaleLaw 2 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i)).prod
    (gaussianReal 0 1)).map (fun p : ℝ × ℝ => 1 + p.1 * p.2) =
      epistemicLayerBranchLaw 2 1 2 (fun i => (1 / 2 : ℝ) * (1 / 2) ^ i) :=
  epistemicLayerScaleLaw_outcome_model _ _ _ _

#print axioms epistemicLayerBranchLaw_probability
#print axioms epistemicLayerScaleLaw_outcome_model
#print axioms epistemicLayerScaleLaw_ae_pos

end TailOptionPricing
