module

/-
  Proper conventional Student laws and the scale correction in
  arXiv:1912.00277v2, Section VI. Normalization follows from the actual
  Normal--Gamma probability law, whose density was evaluated first.
  The printed rate-as-scale error is also refuted as an equality of
  whole proper probability measures, using continuous density uniqueness.
-/
public import Stats.EpistemicUncertainty.GammaCompoundStudentForm
public import Mathlib.MeasureTheory.Function.AEEqOfLIntegral
public import Mathlib.MeasureTheory.Measure.OpenPos

@[expose] public section

open Real Set MeasureTheory ProbabilityTheory Filter

namespace TailOptionPricing

/-- A conventional Student law is generated by actual Gamma precision
of shape nu/2 and rate nu*s^2/2. Positive scale fixes the square-root
sign when recovering the stated Student scale (Section VI). -/
theorem studentMeasure_eq_normalGamma (μ : ℝ) {ν s : ℝ} (hν : 0 < ν) (hs : 0 < s) :
    studentMeasure μ ν s = epistemicNormalGammaLaw μ (ν / 2) (ν / 2 * s ^ 2) := by
  have ha : 0 < ν / 2 := by positivity
  have hr : 0 < ν / 2 * s ^ 2 := by positivity
  have he : epistemicNormalGammaLaw μ (ν / 2) (ν / 2 * s ^ 2) = studentMeasure μ ν s := by
    have h := epistemicNormalGammaLaw_eq_studentMeasure μ ha hr
    have hn : 2 * (ν / 2) = ν := by ring
    have hb : (ν / 2 * s ^ 2) / (ν / 2) = s ^ 2 := by field_simp
    rw [hn, hb, Real.sqrt_sq hs.le] at h
    exact h
  exact he.symm

/-- Every conventional Student law with positive degrees of freedom
and scale is a genuine probability measure. Its normalization comes
from the independent Gamma mixture, not a density certificate. -/
theorem studentMeasure_probability (μ : ℝ) {ν s : ℝ} (hν : 0 < ν) (hs : 0 < s) :
    IsProbabilityMeasure (studentMeasure μ ν s) := by
  rw [studentMeasure_eq_normalGamma μ hν hs]
  exact epistemicNormalGammaLaw_probability μ (by positivity) (by positivity)

/-- The conventional Student density integrates to one for every
positive df and scale, by the proved actual measure normalization. -/
theorem studentPDF_lintegral (μ : ℝ) {ν s : ℝ} (hν : 0 < ν) (hs : 0 < s) :
    (∫⁻ x : ℝ, studentPDF μ ν s x) = 1 := by
  let := studentMeasure_probability μ hν hs
  have h : studentMeasure μ ν s univ = 1 := measure_univ
  simpa only [studentMeasure, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ] using h

/-- The real conventional density is genuinely L1. Independent
probability normalization and the nonnegative density transfer prove
this, so its integral below cannot be an undefined Bochner value. -/
theorem studentPDFReal_integrable (μ : ℝ) {ν s : ℝ} (hν : 0 < ν) (hs : 0 < s) :
    Integrable (studentPDFReal μ ν s) := by
  let := studentMeasure_probability μ hν hs
  have hi : IntegrableOn (fun _ : ℝ => (1 : ℝ)) univ
      (volume.withDensity (fun x => ENNReal.ofReal (studentPDFReal μ ν s x))) := by
    change IntegrableOn (fun _ : ℝ => (1 : ℝ)) univ (studentMeasure μ ν s)
    simpa only [IntegrableOn, Measure.restrict_univ] using
      (integrable_const (μ := studentMeasure μ ν s) (1 : ℝ))
  have h := (realDensity_integrableOn_iff (studentPDFReal μ ν s)
    (studentPDFReal_measurable μ ν s) (studentPDFReal_nonneg μ hν hs)
    (fun _ : ℝ => (1 : ℝ)) MeasurableSet.univ).mp hi
  simpa only [IntegrableOn, Measure.restrict_univ, one_mul] using h

theorem studentPDFReal_integral (μ : ℝ) {ν s : ℝ} (hν : 0 < ν) (hs : 0 < s) :
    (∫ x : ℝ, studentPDFReal μ ν s x) = 1 := by
  have h := integral_eq_lintegral_of_nonneg_ae (μ := volume)
    (Eventually.of_forall (studentPDFReal_nonneg μ hν hs))
    (studentPDFReal_measurable μ ν s).aestronglyMeasurable
  change (∫ x : ℝ, studentPDFReal μ ν s x) = (∫⁻ x : ℝ, studentPDF μ ν s x).toReal at h
  rw [studentPDF_lintegral μ hν hs, ENNReal.toReal_one] at h
  exact h

/-- Actual Student event probabilities are integrals of the
conventional density, including the small-df heavy-tail cases. -/
theorem studentMeasure_apply_density (μ ν s : ℝ) {A : Set ℝ} (hA : MeasurableSet A) :
    studentMeasure μ ν s A = ∫⁻ x in A, studentPDF μ ν s x :=
  withDensity_apply _ hA

theorem studentMeasure_real_apply_density (μ ν s : ℝ) {A : Set ℝ} (hA : MeasurableSet A) :
    (studentMeasure μ ν s).real A = (∫⁻ x in A, studentPDF μ ν s x).toReal :=
  congrArg ENNReal.toReal (studentMeasure_apply_density μ ν s hA)

theorem studentMeasure_absolutelyContinuous (μ ν s : ℝ) : studentMeasure μ ν s ≪ volume :=
  withDensity_absolutelyContinuous _ _

theorem studentMeasure_singleton (μ ν s x : ℝ) : studentMeasure μ ν s {x} = 0 :=
  studentMeasure_absolutelyContinuous μ ν s (by simp)

/-- Distinct conventional scales one and two give distinct whole
Student measures, for any positive df. Density uniqueness first gives
a.e. equality; continuity then makes a location-value comparison valid. -/
theorem studentMeasure_scale_one_ne_two (μ : ℝ) {ν : ℝ} (hν : 0 < ν) :
    studentMeasure μ ν 1 ≠ studentMeasure μ ν 2 := by
  intro he
  change volume.withDensity (studentPDF μ ν 1) = volume.withDensity (studentPDF μ ν 2) at he
  have hae := (withDensity_eq_iff_of_sigmaFinite (studentPDF_measurable μ ν 1).aemeasurable
    (studentPDF_measurable μ ν 2).aemeasurable).mp he
  have hr : studentPDFReal μ ν 1 =ᵐ[volume] studentPDFReal μ ν 2 := by
    filter_upwards [hae] with x hx
    have h := congrArg ENNReal.toReal hx
    simp only [studentPDF] at h
    rw [ENNReal.toReal_ofReal (studentPDFReal_nonneg μ hν (s := 1) (by norm_num) x),
      ENNReal.toReal_ofReal (studentPDFReal_nonneg μ hν (s := 2) (by norm_num) x)] at h
    exact h
  have hf := Measure.eq_of_ae_eq hr (studentPDFReal_continuous μ 1 hν) (studentPDFReal_continuous μ 2 hν)
  exact studentPDFReal_scale_one_ne_two μ hν (congrFun hf μ)

/-- A concrete pair of proper probability laws refutes Section VI's
claim that Gamma rate r is the conventional Student scale. Shape two,
rate two yields df four and scale one; scale two gives a different law. -/
theorem epistemic_gamma_student_law_counterexample :
    IsProbabilityMeasure (epistemicNormalGammaLaw 0 2 2) ∧
      IsProbabilityMeasure (studentMeasure 0 4 2) ∧
      epistemicNormalGammaLaw 0 2 2 ≠ studentMeasure 0 4 2 := by
  refine ⟨epistemicNormalGammaLaw_probability 0 (by norm_num) (by norm_num),
    studentMeasure_probability 0 (by norm_num) (by norm_num), ?_⟩
  have he := epistemicNormalGammaLaw_eq_studentMeasure 0 (a := 2) (r := 2) (by norm_num) (by norm_num)
  norm_num at he
  rw [he]
  exact studentMeasure_scale_one_ne_two 0 (by norm_num)

example : IsProbabilityMeasure (studentMeasure 1 (1 / 2) 2) :=
  studentMeasure_probability 1 (by norm_num) (by norm_num)

example : studentMeasure 1 (1 / 2) 2 =
    epistemicNormalGammaLaw 1 ((1 / 2) / 2) ((1 / 2) / 2 * 2 ^ 2) :=
  studentMeasure_eq_normalGamma 1 (by norm_num) (by norm_num)

example : (∫⁻ x : ℝ, studentPDF 1 (1 / 2) 2 x) = 1 :=
  studentPDF_lintegral 1 (by norm_num) (by norm_num)

example : Integrable (studentPDFReal 1 (1 / 2) 2) :=
  studentPDFReal_integrable 1 (by norm_num) (by norm_num)

example : (∫ x : ℝ, studentPDFReal 1 (1 / 2) 2 x) = 1 :=
  studentPDFReal_integral 1 (by norm_num) (by norm_num)

example : studentMeasure 1 (1 / 2) 2 (Ici 3) = ∫⁻ x in Ici 3, studentPDF 1 (1 / 2) 2 x :=
  studentMeasure_apply_density 1 (1 / 2) 2 measurableSet_Ici

example : (studentMeasure 1 (1 / 2) 2).real (Ici 3) =
    (∫⁻ x in Ici 3, studentPDF 1 (1 / 2) 2 x).toReal :=
  studentMeasure_real_apply_density 1 (1 / 2) 2 measurableSet_Ici

example : studentMeasure 1 (1 / 2) 2 ≪ volume := studentMeasure_absolutelyContinuous 1 (1 / 2) 2

example : studentMeasure 1 (1 / 2) 2 {3} = 0 := studentMeasure_singleton 1 (1 / 2) 2 3

example : studentMeasure 0 4 1 ≠ studentMeasure 0 4 2 := studentMeasure_scale_one_ne_two 0 (by norm_num)

#print axioms studentMeasure_probability
#print axioms studentPDFReal_integrable
#print axioms studentPDFReal_integral
#print axioms studentMeasure_scale_one_ne_two
#print axioms epistemic_gamma_student_law_counterexample

end TailOptionPricing
